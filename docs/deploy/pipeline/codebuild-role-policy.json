{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteItsOwnBuildLog",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:<acct>:log-group:/aws/codebuild/cloudshop-build",
        "arn:aws:logs:us-east-1:<acct>:log-group:/aws/codebuild/cloudshop-build:*"
      ]
    },
    {
      "Sid": "ReadTheSourceAndWriteTheJar",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::<artifact-bucket>/cloudshop-pipeline/*"
    },
    {
      "Sid": "FindTheArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::<artifact-bucket>"
    }
  ]
}
