# ---------------------------------------------------------------------------
# CloudShop - environment variable template
#
# Copy to .env and fill in real values. .env is gitignored; this file is the
# whitelisted exception (.gitignore: "!.env.example"), so it must never contain
# a real credential.
#
# Every variable below is read by src/main/resources/application.properties.
# The three marked REQUIRED have no default on purpose - they are credentials.
# Everything else has a working local-development default, shown after its name.
#
# Nothing reads this file automatically - Spring Boot has no .env support. Use it
# as the source of truth when setting real values:
#   local    export them in the shell, or `set -a; . ./.env; set +a`
#   Azure    App Service > Configuration > Application settings
#   Heroku   `heroku config:set NAME=value`
# ---------------------------------------------------------------------------

# --- Profile ----------------------------------------------------------------

# Leave unset to run against MySQL. Set to "h2" to run against an in-memory H2
# database in MySQL mode instead - no MySQL, no Docker, and none of the DB_*
# variables below are needed. Data is lost on every restart. See README.md.
# SPRING_PROFILES_ACTIVE=h2

# --- HTTP -------------------------------------------------------------------

# Port the embedded Tomcat binds to. Both PaaS targets assign this at runtime:
# Heroku injects it into the dyno, Azure App Service sets it for the Java SE
# container. Leave unset locally to get 8080.
PORT=8080

# --- Owner account ----------------------------------------------------------

# REQUIRED to have an owner. The shop's single owner account is created at
# startup from these two values when no owner exists yet. There is no default
# and no way to register an owner through the website. If either is missing the
# shop still starts, but logs a warning and nobody can sign in as the owner.
#
# They are only used to CREATE the account. Once an owner exists, changing them
# does nothing - a redeploy can never reset the owner's password.
OWNER_USERNAME=replace-with-the-owner-username
OWNER_PASSWORD=replace-with-a-long-owner-password

# The owner row needs an email address, because users.email is NOT NULL and
# unique. Optional - this default is fine unless a buyer needs that address.
OWNER_EMAIL=owner@cloudshop.local

# --- Database (ignored when SPRING_PROFILES_ACTIVE=h2) ----------------------

# Hostname of the MySQL server.
# Azure:  <server-name>.mysql.database.azure.com
# Heroku: the host segment of JAWSDB_URL (mysql://user:pass@HOST:port/db)
DB_HOST=localhost

# MySQL port. Managed services generally keep 3306; JawsDB sometimes does not,
# so take it from JAWSDB_URL rather than assuming.
DB_PORT=3306

# Schema name. On JawsDB this is assigned for you and cannot be renamed - read it
# from the path segment of JAWSDB_URL.
DB_NAME=cloudshopdb

# Application database user. Needs CREATE/ALTER/DROP on DB_NAME, because Flyway
# builds the schema on first start.
DB_USER=cloudshop_app

# REQUIRED - the application refuses to start without it, enforced by
# RequiredDatabasePasswordValidator before any bean is created. There is no
# fallback on purpose: a committed default would let a misconfigured deployment
# start and then fail with an opaque "Access denied" error.
DB_PASSWORD=replace-with-your-database-password

# TLS mode passed to the MySQL connector.
#   DISABLED  a local MySQL only
#   REQUIRED  Azure Database for MySQL Flexible Server, which runs
#             require_secure_transport=ON and will reject a plaintext connection
# Set this to REQUIRED on any managed database.
DB_SSL_MODE=DISABLED

# Maximum HikariCP pool size. Managed tiers cap total connections aggressively -
# the JawsDB free plan allows only a handful, and the default of 10 can consume
# the entire allowance with no headroom for a restart, when the old and new dynos
# briefly overlap. Lower this to about 5 on a free-tier database.
DB_POOL_MAX=10

# Connections Hikari keeps open while idle.
DB_POOL_MIN=2

# Milliseconds to wait for a connection from the pool before failing. Worth
# raising if the database is in a different region from the application.
DB_CONNECTION_TIMEOUT_MS=20000

# --- Flyway -----------------------------------------------------------------

# Whether migrations run at startup. Leave true unless the schema is applied by a
# separate release step.
FLYWAY_ENABLED=true

# Leave false. When true and Flyway meets a database that already has tables but
# no flyway_schema_history, it writes a baseline row and SKIPS V1 instead of
# applying it - the application then starts looking healthy against a schema that
# was never created.
FLYWAY_BASELINE_ON_MIGRATE=false

# Flyway's own log level. INFO records which migrations were applied; the root
# logger is WARN, so anything higher than INFO leaves a deployment with no record
# of what it did to the schema.
FLYWAY_LOG_LEVEL=INFO

# --- Logging and development toggles ----------------------------------------

# Level for this application's own loggers (edu.gcu.cst323.cloudshop). The
# service layer logs registrations, purchases and inventory changes at INFO.
APP_LOG_LEVEL=INFO

# Echo generated SQL to the log. Debugging only - noisy, and it can surface data
# values into the platform log stream.
JPA_SHOW_SQL=false

# Thymeleaf template caching. True everywhere except local development, where
# spring-boot-devtools turns it off automatically.
THYMELEAF_CACHE=true

# --- Not configurable, on purpose -------------------------------------------
# The actuator exposes only /actuator/health and /actuator/info, and health
# never shows component detail. Both are reachable without signing in, so they
# are fixed in application.properties rather than read from the environment.
